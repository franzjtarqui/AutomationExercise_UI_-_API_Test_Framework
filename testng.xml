<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Parallelism (PLAN.md section 1: "parallel execution per scenario"):
  - UI/API: each Cucumber scenario is a row of the runners' @DataProvider(parallel=true);
    "data-provider-thread-count" governs how many scenarios run at the same time. 2 is a
    deliberate balance between speed and stability: automationexercise.com is a practice site
    with third-party ads/overlays (PLAN.md section 10), and higher values increased the
    observed flakiness (timeouts, Cloudflare challenges/5xx errors under load) in CI runs
    from data-center IPs. 4 was tried first and consistently failed in CI on the scenarios
    that register a user and navigate right after (GitHub Actions/Azure IPs are challenged by
    Cloudflare more aggressively; see WaitUtils.CloudflareChallenge).
  - Unit: doesn't use @DataProvider: it's parallelized per class with the <test>'s
    "parallel"/"thread-count" attribute, independent of the data-provider-thread-count above.
  - RetryTransformer (com.portfolio.ae.listeners) retries any failing test once, an additional
    mitigation for the site's residual flakiness under parallelism (PLAN.md section 10).
  - Cloudflare: WaitUtils detects the "Just a moment..." interstitial and waits for it to
    resolve before failing, and BasePage.open() waits it out after every navigation.
-->
<suite name="AutomationExercise - All Suites" verbose="1" data-provider-thread-count="2">
    <listeners>
        <listener class-name="com.portfolio.ae.listeners.RetryTransformer"/>
    </listeners>
    <test name="UI">
        <classes>
            <class name="com.portfolio.ae.runners.UIRunner"/>
        </classes>
    </test>
    <test name="API">
        <classes>
            <class name="com.portfolio.ae.runners.ApiRunner"/>
        </classes>
    </test>
    <test name="Unit" parallel="classes" thread-count="4">
        <classes>
            <class name="com.portfolio.ae.utils.JsonReaderTest"/>
            <class name="com.portfolio.ae.utils.FakerUtilTest"/>
            <class name="com.portfolio.ae.utils.AssertionsTest"/>
            <class name="com.portfolio.ae.data.UserBuilderTest"/>
            <class name="com.portfolio.ae.data.ExpectedMessagesTest"/>
            <class name="com.portfolio.ae.data.ProductFixturesTest"/>
            <class name="com.portfolio.ae.api.models.ApiModelsTest"/>
            <class name="com.portfolio.ae.api.models.AccountRequestTest"/>
            <class name="com.portfolio.ae.api.clients.BaseApiClientTest"/>
            <class name="com.portfolio.ae.api.clients.ProductApiClientTest"/>
            <class name="com.portfolio.ae.api.clients.BrandApiClientTest"/>
            <class name="com.portfolio.ae.api.clients.SearchApiClientTest"/>
            <class name="com.portfolio.ae.api.clients.AuthApiClientTest"/>
            <class name="com.portfolio.ae.api.clients.AccountApiClientTest"/>
        </classes>
    </test>
</suite>
